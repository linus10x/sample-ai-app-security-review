{
  "name": "cedar-supply-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Cedar Supply Portal: a synthetic B2B ordering app used for a security review sample",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage --reporter=default --reporter=json --outputFile.json=coverage/unit-results.json",
    "test:exploits": "vitest run --config vitest.exploits.config.mts",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.63.0",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "next": "16.4.3",
    "undici": "8.12.3",
    "zod": "4.6.7",
    "dompurify": "3.4.17",
    "vite": "8.3.5",
    "katex": "0.18.2"
  }
}
