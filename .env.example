# Copy to .env for local use. Every value here is a fake placeholder.
# `make demo` fills in the real local-only values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=fake-anon-key-for-demo
SUPABASE_SERVICE_ROLE_KEY=fake-for-demo
STRIPE_SECRET_KEY=sk_test_123
STRIPE_WEBHOOK_SECRET=whsec_fake_for_local_demo
# stripe-mock (docker compose up stripe-mock)
STRIPE_API_HOST=127.0.0.1
STRIPE_API_PORT=12111
STRIPE_API_PROTOCOL=http
APP_URL=http://localhost:3000
# Comma-separated hosts the "import from URL" feature may call
IMPORT_ALLOWED_HOSTS=catalog.example.com
